datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Model for Authentication and Role
enum Role {
  OWNER
  ADMIN
  WAREHOUSE
  SALES
  DRIVER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          Role      @default(SALES)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  purchaseOrders PurchaseOrder[] @relation("PoCreatedBy")
  salesOrders    SalesOrder[]    @relation("SoCreatedBy")
  pickings       Picking[]
  deliveries     Delivery[]
  payments       Payment[]
  auditLogs      AuditLog[]
  carts          Cart[]
  userVouchers   UserVoucher[]
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carts")
}

model Promotion {
  id            String    @id @default(cuid())
  name          String
  type          String    // product, category, coupon, flash-sale, bundle
  discountType  String    @default("percentage") // percentage, fixed
  discountValue Float     @default(0)
  targetId      String?
  targetName    String?
  code          String?   @unique
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vouchers      UserVoucher[]

  @@map("promotions")
}

model UserVoucher {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotionId String?    @map("promotion_id")
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  code        String
  value       Float      @default(0)
  status      String     @default("ACTIVE") // ACTIVE, USED, EXPIRED
  usedAt      DateTime?
  rawData     Json?      @map("raw_data")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("user_vouchers")
}

model LedgerEntry {
  id            String   @id @default(cuid())
  debitAccount  String   @map("debit_account")
  creditAccount String   @map("credit_account")
  amount        Float
  memo          String?
  refType       String?  @map("ref_type")
  refId         String?  @map("ref_id")
  postedBy      String?  @default("system") @map("posted_by")
  rawData       Json?    @map("raw_data")
  date          DateTime @default(now())
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("ledger_entries")
}

model InventoryLog {
  id              String   @id @default(cuid())
  productId       String?  @map("product_id")
  productName     String?  @map("product_name")
  warehouseId     String?  @map("warehouse_id")
  fromWarehouseId String?  @map("from_warehouse_id")
  toWarehouseId   String?  @map("to_warehouse_id")
  type            String?  // IN, OUT, ADJUSTMENT, OPNAME, TRANSFER, MARKETPLACE, ORDER
  source          String?
  amount          Float?
  quantity        Int?
  prevStock       Int?     @map("prev_stock")
  nextStock       Int?     @map("next_stock")
  referenceId     String?  @map("reference_id")
  orderId         String?  @map("order_id")
  adminId         String?  @map("admin_id")
  note            String?
  rawData         Json?    @map("raw_data")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("inventory_logs")
}

model StockSyncLog {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  productName   String?  @map("product_name")
  warehouseId   String   @map("warehouse_id")
  warehouseName String?  @map("warehouse_name")
  type          String   // WAREHOUSE_TO_PRODUCT, BATCH_SYNC, etc
  status        String   @default("SUCCESS") // SUCCESS, COMPLETED, ERROR
  quantity      Int?
  previousStock Int?     @map("previous_stock")
  newStock      Int?     @map("new_stock")
  difference    Int?
  systemStock   Int?     @map("system_stock")
  reason        String?
  synced        Boolean? @default(true)
  syncError     String?  @map("sync_error")
  executionTime Float?   @map("execution_time")
  operator      String?
  timestamp     DateTime @default(now())
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("stockSyncLogs")
}

model StockValidation {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  warehouseId   String   @map("warehouse_id")
  systemStock   Int      @map("system_stock")
  physicalStock Int      @map("physical_stock")
  difference    Int      @default(0)
  status        String   @default("VALID") // VALID, INVALID, PENDING
  lastSync      DateTime @default(now()) @map("last_sync")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([productId, warehouseId])
  @@map("stockValidations")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Supplier {
  id             String    @id @default(cuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  products       Product[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  email       String?
  address     String?
  type        String?   // Retail, Grosir, dll
  salesOrders SalesOrder[]
  invoices    Invoice[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  description String?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  
  costPrice   Float     // Harga Modal
  sellPrice   Float     // Harga Jual
  unit        String    // Pcs, Dus, dll
  
  batches     InventoryBatch[]
  movements   InventoryMovement[]
  poItems     PurchaseOrderItem[]
  soItems     SalesOrderItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Warehouse {
  id          String    @id @default(cuid())
  name        String
  address     String?
  batches     InventoryBatch[]
  movements   InventoryMovement[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model InventoryBatch {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  
  batchNumber String
  quantity    Int
  expiryDate  DateTime?
  
  movements   InventoryMovement[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

model InventoryMovement {
  id          String    @id @default(cuid())
  batchId     String
  batch       InventoryBatch @relation(fields: [batchId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  
  type        MovementType
  quantity    Int       // Positive for IN/ADJUSTMENT+, negative for OUT/ADJUSTMENT-
  reference   String?   // PO Number, SO Number, etc
  notes       String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  poNumber    String    @unique
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  createdById String
  createdBy   User      @relation("PoCreatedBy", fields: [createdById], references: [id])
  
  status      POStatus  @default(DRAFT)
  totalAmount Float
  notes       String?
  
  items       PurchaseOrderItem[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PurchaseOrderItem {
  id          String    @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  
  quantity    Int
  unitPrice   Float
  totalPrice  Float
}

enum SOStatus {
  DRAFT
  CONFIRMED
  PICKING
  PACKING
  DELIVERING
  COMPLETED
  CANCELLED
}

model SalesOrder {
  id          String    @id @default(cuid())
  soNumber    String    @unique
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  createdById String
  createdBy   User      @relation("SoCreatedBy", fields: [createdById], references: [id])
  
  status      SOStatus  @default(DRAFT)
  totalAmount Float
  notes       String?
  
  items       SalesOrderItem[]
  picking     Picking?
  delivery    Delivery?
  invoice     Invoice?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SalesOrderItem {
  id          String    @id @default(cuid())
  soId        String
  so          SalesOrder @relation(fields: [soId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  
  quantity    Int
  unitPrice   Float
  totalPrice  Float
}

model Picking {
  id          String    @id @default(cuid())
  soId        String    @unique
  so          SalesOrder @relation(fields: [soId], references: [id])
  pickerId    String
  picker      User      @relation(fields: [pickerId], references: [id])
  
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Delivery {
  id          String    @id @default(cuid())
  soId        String    @unique
  so          SalesOrder @relation(fields: [soId], references: [id])
  driverId    String
  driver      User      @relation(fields: [driverId], references: [id])
  
  status      String    @default("PENDING") // PENDING, ON_THE_WAY, DELIVERED, FAILED
  notes       String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

model Invoice {
  id          String    @id @default(cuid())
  invoiceNo   String    @unique
  soId        String    @unique
  so          SalesOrder @relation(fields: [soId], references: [id])
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  
  status      InvoiceStatus @default(UNPAID)
  totalAmount Float
  amountPaid  Float     @default(0)
  dueDate     DateTime?
  
  payments    Payment[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Payment {
  id            String    @id @default(cuid())
  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id])
  receivedById  String
  receivedBy    User      @relation(fields: [receivedById], references: [id])
  
  amount        Float
  paymentMethod String    // CASH, TRANSFER, dll
  reference     String?   // Bukti transfer
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Expense {
  id             String    @id @default(cuid())
  category       String    // Operasional, Gaji, dll
  amount         Float
  description    String?
  date           DateTime  @default(now())
  proofOfPayment String?   @map("proof_of_payment")
  recordedBy     String?   @map("recorded_by")
  rawData        Json?     @map("raw_data")
  
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("operational_expenses")
}

model BusinessSetting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  description String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  action      String
  entity      String    // Product, SO, dll
  entityId    String
  details     String?
  
  createdAt   DateTime  @default(now())
}

model CapitalTransaction {
  id          String   @id @default(cuid())
  type        String   // INJECTION, WITHDRAWAL
  amount      Float
  description String?
  recordedBy  String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Loan {
  id              String    @id @default(cuid())
  lenderName      String
  amount          Float
  remainingAmount Float
  description     String?
  loanType        String    @default("STANDARD")
  interestRate    Float     @default(0)
  status          String    @default("ACTIVE") // ACTIVE, PAID
  startDate       DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MarketplaceAccount {
  id             String    @id @default(cuid())
  name           String
  storeName      String?
  activeBalance  Float     @default(0)
  pendingBalance Float     @default(0)
  updatedAt      DateTime  @updatedAt
}

model MarketplaceTransaction {
  id            String    @id @default(cuid())
  accountId     String
  name          String
  storeName     String?
  type          String    // ADJUST, WITHDRAWAL, DEPOSIT
  amount        Float?
  activeChange  Float?
  pendingChange Float?
  recordedBy    String?
  note          String?
  date          DateTime  @default(now())
}

